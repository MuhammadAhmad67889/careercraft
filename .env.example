# Copy this file to .env and fill in real values. Never commit .env.

# Database. Production (Neon) uses a postgresql:// URL, and the
# committed Prisma schema is set to postgresql. For local dev
# with a SQLite file, change the provider in
# prisma/schema.prisma to "sqlite" and use a file: URL here.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies and hash tokens.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL of the app, used in password-reset links.
APP_URL="http://localhost:3000"

# Optional: email sending for password resets.
# Leave unset in local dev — reset links are printed to the server
# console instead of emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Later phases: live AI via a provider switch (all providers speak
# the OpenAI chat-completions shape). Free tiers change — re-check
# before relying on any of them.
#
# LLM_PROVIDER: groq (default) | mistral | openrouter | pollinations
# Leave LLM_API_KEY empty for clearly-labelled demo mode. With a
# key set, live failures are shown as errors — the app never
# silently falls back to demo text.
LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL=""
